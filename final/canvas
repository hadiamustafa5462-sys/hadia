<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Interactive JS Paint</title>
    <style>
        /* CSS: Styling the UI */
        body {
            margin: 0;
            display: flex;
            flex-direction: column;
            align-items: center;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #f4f4f9;
        }

        .toolbar {
            padding: 15px;
            background: #2c3e50;
            width: 100%;
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 20px;
            box-shadow: 0 2px 5px rgba(0,0,0,0.2);
        }

        label {
            color: white;
            font-weight: bold;
        }

        input[type="color"] {
            border: none;
            width: 40px;
            height: 40px;
            cursor: pointer;
            background: none;
        }

        #clearBtn {
            padding: 10px 20px;
            background-color: #e74c3c;
            color: white;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            font-weight: bold;
            transition: background 0.3s;
        }

        #clearBtn:hover {
            background-color: #c0392b;
        }

        canvas {
            margin-top: 20px;
            border: 2px solid #2c3e50;
            border-radius: 4px;
            background-color: white;
            cursor: crosshair;
            box-shadow: 0 10px 20px rgba(0,0,0,0.1);
        }
    </style>
</head>
<body>

    <div class="toolbar">
        <label for="colorPicker">Brush Color:</label>
        <input type="color" id="colorPicker" value="#000000">
        <button id="clearBtn">Clear Canvas</button>
    </div>

    <canvas id="paintCanvas"></canvas>

    <script>
        // JavaScript: Handling the Logic
        const canvas = document.getElementById('paintCanvas');
        const ctx = canvas.getContext('2d');
        const colorPicker = document.getElementById('colorPicker');
        const clearBtn = document.getElementById('clearBtn');

        // Initialize Canvas Dimensions
        canvas.width = window.innerWidth * 0.9;
        canvas.height = 600;

        let painting = false;

        // Start drawing when mouse is pressed
        function startPosition(e) {
            painting = true;
            draw(e); 
        }

        // Stop drawing when mouse is released
        function finishedPosition() {
            painting = false;
            ctx.beginPath(); // Resets the path so strokes don't connect
        }

        // The drawing logic
        function draw(e) {
            if (!painting) return;

            // Brush Settings
            ctx.lineWidth = 5;
            ctx.lineCap = 'round';
            ctx.strokeStyle = colorPicker.value;

            // Calculate Mouse Position relative to Canvas
            const rect = canvas.getBoundingClientRect();
            const x = e.clientX - rect.left;
            const y = e.clientY - rect.top;

            // Create the line
            ctx.lineTo(x, y);
            ctx.stroke();
            
            // Smoothen the drawing path
            ctx.beginPath();
            ctx.moveTo(x, y);
        }

        // Event Listeners for Mouse Actions
        canvas.addEventListener('mousedown', startPosition);
        canvas.addEventListener('mouseup', finishedPosition);
        canvas.addEventListener('mousemove', draw);
        
        // Handle Mouse leaving the canvas area
        canvas.addEventListener('mouseleave', finishedPosition);

        // Clear Button Logic
        clearBtn.addEventListener('click', () => {
            ctx.clearRect(0, 0, canvas.width, canvas.height);
        });
    </script>
</body>
</html>
